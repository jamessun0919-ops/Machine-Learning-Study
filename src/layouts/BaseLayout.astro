---
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="reading-progress" aria-hidden="true"></div>
    <slot />
  </body>
</html>
