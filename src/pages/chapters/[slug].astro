---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import ChapterSummaryCard from '../../components/ChapterSummaryCard.astro';
import RegressionScatter3D from '../../components/charts/RegressionScatter3D';
import RegressionScatter2D from '../../components/charts/RegressionScatter2D';
import CourseKnowledgeMap from '../../components/CourseKnowledgeMap';
import FeatureScalingComparison from '../../components/charts/FeatureScalingComparison';
import TrainTestSplitComparison from '../../components/charts/TrainTestSplitComparison';
import OverfittingUnderfittingComparison from '../../components/charts/OverfittingUnderfittingComparison';
import PolynomialRegressionFit from '../../components/charts/PolynomialRegressionFit';
import RidgeRegressionFit from '../../components/charts/RidgeRegressionFit';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  return chapters.map((chapter) => ({
    params: { slug: chapter.id },
    props: { chapter },
  }));
}

interface Props {
  chapter: CollectionEntry<'chapters'>;
}

const { chapter } = Astro.props;
const { Content } = await render(chapter);
---
<BaseLayout title={chapter.data.title}>
  <Nav />
  <main class="chapter">
    <div class="chapter__header">
      <h1>{chapter.data.title}</h1>
      <nav class="chapter__jump-nav" aria-label="章節內快速跳轉">
        {chapter.data.summary && <a href="#summary">資訊圖表</a>}
        {chapter.data.interactiveComponent && <a href="#interactive">互動操作</a>}
      </nav>
    </div>
    <Content />
    {chapter.data.summary && (
      <ChapterSummaryCard
        formulas={chapter.data.summary.formulas}
        keyStats={chapter.data.summary.keyStats}
        image={chapter.data.summary.image}
      />
    )}
    {chapter.data.interactiveComponent === 'regression-scatter-3d' && (
      <section class="chapter__interactive" id="interactive">
        <h2>互動式操作與演示</h2>
        <RegressionScatter3D client:only="react">
          <div slot="fallback" class="regression-chart__skeleton">互動圖表載入中……</div>
        </RegressionScatter3D>
      </section>
    )}
    {chapter.data.interactiveComponent === 'regression-scatter-2d' && (
      <section class="chapter__interactive" id="interactive">
        <h2>互動式操作與演示</h2>
        <RegressionScatter2D client:only="react">
          <div slot="fallback" class="regression-chart__skeleton">互動圖表載入中……</div>
        </RegressionScatter2D>
      </section>
    )}
    {chapter.data.interactiveComponent === 'course-knowledge-map' && (
      <section class="chapter__interactive" id="interactive">
        <h2>互動式操作與演示</h2>
        <CourseKnowledgeMap client:only="react">
          <div slot="fallback" class="regression-chart__skeleton">知識地圖載入中……</div>
        </CourseKnowledgeMap>
      </section>
    )}
    {chapter.data.interactiveComponent === 'feature-scaling-comparison' && (
      <section class="chapter__interactive" id="interactive">
        <h2>互動式操作與演示</h2>
        <FeatureScalingComparison client:only="react">
          <div slot="fallback" class="regression-chart__skeleton">互動圖表載入中……</div>
        </FeatureScalingComparison>
      </section>
    )}
    {chapter.data.interactiveComponent === 'train-test-split-comparison' && (
      <section class="chapter__interactive" id="interactive">
        <h2>互動式操作與演示</h2>
        <TrainTestSplitComparison client:only="react">
          <div slot="fallback" class="regression-chart__skeleton">互動圖表載入中……</div>
        </TrainTestSplitComparison>
      </section>
    )}
    {chapter.data.interactiveComponent === 'overfitting-underfitting-comparison' && (
      <section class="chapter__interactive" id="interactive">
        <h2>互動式操作與演示</h2>
        <OverfittingUnderfittingComparison client:only="react">
          <div slot="fallback" class="regression-chart__skeleton">互動圖表載入中……</div>
        </OverfittingUnderfittingComparison>
      </section>
    )}
    {chapter.data.interactiveComponent === 'polynomial-regression-fit' && (
      <section class="chapter__interactive" id="interactive">
        <h2>互動式操作與演示</h2>
        <PolynomialRegressionFit client:only="react">
          <div slot="fallback" class="regression-chart__skeleton">互動圖表載入中……</div>
        </PolynomialRegressionFit>
      </section>
    )}
    {chapter.data.interactiveComponent === 'ridge-regression-fit' && (
      <section class="chapter__interactive" id="interactive">
        <h2>互動式操作與演示</h2>
        <RidgeRegressionFit client:only="react">
          <div slot="fallback" class="regression-chart__skeleton">互動圖表載入中……</div>
        </RidgeRegressionFit>
      </section>
    )}
  </main>
  {/* Inline and placed after the content on purpose: it runs during parsing,
      while a bundled (deferred) script would let the finished markers paint
      first and then visibly collapse before revealing. */}
  <script is:inline>
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (!('IntersectionObserver' in window)) return;

      var chapter = document.querySelector('.chapter');
      if (!chapter) return;

      var headings = chapter.querySelectorAll('h2');
      if (!headings.length) return;

      chapter.classList.add('js-marker-reveal');

      var remaining = headings.length;
      var observer = new IntersectionObserver(
        function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (!entries[i].isIntersecting) continue;
            entries[i].target.classList.add('is-in-view');
            observer.unobserve(entries[i].target);
            remaining -= 1;
          }
          if (remaining === 0) observer.disconnect();
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.15 }
      );

      for (var j = 0; j < headings.length; j++) observer.observe(headings[j]);
    })();
  </script>
</BaseLayout>
